{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [],
	"quoteProps": "consistent",
	"printWidth": 120,
	"trailingComma": "all",
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"endOfLine": "lf",
	"arrowParens": "avoid",
	"sortImports": true,
	"astro": true,
	"sortTailwindcss": { "stylesheet": "./src/index.css", "functions": ["clsx", "cn", "cva"] },
	"sortPackageJson": { "sortScripts": true }
}
