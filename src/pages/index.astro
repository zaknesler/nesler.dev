---
import GitHubIcon from '@/assets/github.svg';
import LastFmIcon from '@/assets/lastfm.svg';
import Badge from '@/components/badge.astro';
import IntroText from '@/components/intro.md';
import BaseLayout from '@/layouts/base.astro';

import data from '../../public/resume.json';

const links = [
	{ title: 'GitHub', path: data.urls.github, icon: GitHubIcon },
	{ title: 'Last.fm', path: data.urls.lastfm, icon: LastFmIcon },
] as const;
---

<BaseLayout description={data.about}>
	<div class="prose flex flex-col gap-4">
		<IntroText />
	</div>

	<div class="flex flex-wrap gap-3 text-sm font-medium">
		{links.map(link => (
			<Badge {...link} />
		))}
	</div>
</BaseLayout>
