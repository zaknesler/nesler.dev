---
import GitHubIcon from '@/assets/github.svg';
import LinkedInIcon from '@/assets/linkedin.svg';

import data from '../../public/resume.json';

const onHome = Astro.routePattern === '/';
const onResume = Astro.routePattern === '/resume';

const socialLinks = [
	{ label: 'GitHub', icon: GitHubIcon, url: data.urls.github },
	{ label: 'LinkedIn', icon: LinkedInIcon, url: data.urls.linkedin },
] as const;

const TitleTag = onHome ? 'div' : 'a';
const SubtitleTag = onResume ? 'div' : 'a';
---

<nav class:list={['flex flex-col gap-4', onResume && 'flex-row items-center justify-between text-start']}>
	<div class="flex flex-col items-start">
		<TitleTag href={onHome ? undefined : '/'} class:list={[!onHome && 'hover:underline']}>
			<h3 class="font-semibold text-olive-950 dark:text-olive-100">Zak Nesler</h3>
		</TitleTag>

		<SubtitleTag href={onResume ? undefined : '/resume'}>
			<h4
				class:list={[
					'text-2xs font-medium tracking-wide text-olive-500 uppercase dark:text-olive-600',
					!onResume && 'hover:underline',
				]}
			>
				{data.title}
			</h4>
		</SubtitleTag>
	</div>

	{onResume && (
		<div class="flex flex-col gap-2 text-right text-xs font-medium">
			<div class="flex items-center justify-end gap-3">
				{socialLinks.map(({ label, icon, url }) => (
					<a href={url} target="_blank" rel="noopener noreferrer" title={label}>
						<img src={icon.src} class="size-4" alt={label} />
					</a>
				))}
			</div>

			<div class="text-xs" set:html={data.email} />
		</div>
	)}
</nav>
