---
type Props = {
	title: string;
	right?: string;
};

const { title, right } = Astro.props;
---

<div class="flex flex-col gap-1">
	<div class="flex items-center justify-between">
		<h3 class="text-sm font-semibold tracking-wide uppercase sm:text-xs">{title}</h3>

		{right && <div class="hidden text-xs xs:flex">{right}</div>}
	</div>

	<hr class="border border-gray-200 dark:border-gray-800" />
</div>
