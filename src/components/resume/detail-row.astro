---
import Badge from '../badge.astro';

type Props = {
	title: string;
	subheadings: string[];
	items: string[];
};

const { title, subheadings, items } = Astro.props as Props;
---

<div class="flex flex-col gap-4">
	<div class="flex flex-row flex-wrap items-start justify-between gap-3">
		<div class="flex flex-col gap-1">
			<div class="leading-5 font-medium text-gray-950 dark:text-gray-100">{title}</div>

			<div class="flex flex-col gap-0.5">
				{subheadings.map(text => (
					<div class="text-sm/4 text-gray-500 dark:text-gray-400">{text}</div>
				))}
			</div>
		</div>

		<div class="flex shrink-0 items-center gap-2 text-xs font-medium text-gray-700 dark:text-gray-200">
			{items.map(item => (
				<Badge title={item} />
			))}
		</div>
	</div>

	<div class="flex flex-col gap-4">
		<slot />
	</div>
</div>
