---
import type { HTMLAttributes } from 'astro/types';

type Props = {
	title: string;
	path?: string;
	icon?: (_props: HTMLAttributes<'svg'>) => unknown;
};

const { title, path, icon: Icon } = Astro.props;

const Tag = path ? 'a' : 'span';
---

<Tag
	href={path}
	class:list={[
		'group relative inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 transition',
		'border border-gray-300 bg-linear-to-b from-white to-gray-100 text-gray-600',
		'ring-0 inset-shadow-light ring-gray-300 ring-offset-2 ring-offset-gray-100',
		path && 'hover:border-gray-500 hover:text-gray-900 hover:ring-2',
		'dark:border-gray-700 dark:from-gray-800 dark:to-gray-900 dark:text-gray-300',
		'dark:inset-shadow-dark dark:ring-gray-800 dark:ring-offset-gray-950',
		path && 'dark:hover:border-gray-500 dark:hover:text-gray-100',
	]}
	target={path && !path.startsWith('/') ? '_blank' : undefined}
	rel={path && !path.startsWith('/') ? 'noopener' : undefined}
>
	{title}
	{Icon && <Icon class="size-4 opacity-50 grayscale transition group-hover:opacity-100 group-hover:grayscale-0" />}
</Tag>
