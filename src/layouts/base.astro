---
import { SEO, type SEOProps } from 'astro-seo';
import '@fontsource-variable/inter';

import Title from '@/components/title.astro';

import '../index.css';
import { favicons } from '../constants/favicons';

type Props = {
	title?: string;
	description?: string;
	openGraph?: SEOProps['openGraph'];
};

const { title, description, openGraph } = Astro.props as Props;
---

<html lang="en" class="h-full w-full">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<SEO
			{title}
			{description}
			{openGraph}
			titleDefault="Zak Nesler"
			titleTemplate="%s — Zak Nesler"
			charset="utf-8"
			twitter={{ creator: '@zaknesler' }}
			extend={{
				link: [
					...favicons,
					{ rel: 'manifest', href: '/manifest.json' },
					{ rel: 'sitemap', href: '/sitemap-index.xml' },
				],
			}}
		/>

		<script async src="https://a.zak.fm/js/pa-l6uh6Xn3fSlHtGGQBh1fb.js"></script>
		<script async src="/plausible.js"></script>
	</head>

	<body class="h-full w-full bg-olive-100 text-olive-500 selection:bg-olive-500/20 dark:bg-olive-950 dark:text-olive-400">
		<div class="mx-auto flex w-full max-w-2xl flex-col gap-6 p-8 lg:py-16 print:max-w-none">
			<Title />
			<slot />
		</div>
	</body>
</html>
