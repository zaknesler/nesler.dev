---
import { SEO, type SEOProps } from 'astro-seo';
import '@fontsource-variable/inter';

import Title from '@/components/title.astro';

import { favicons } from '../constants/favicons';

import '../index.css';

type Props = {
	title?: string;
	description?: string;
	openGraph?: SEOProps['openGraph'];
};

const { title, description, openGraph } = Astro.props as Props;
---

<html lang="en" class="h-full w-full">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<SEO
			{title}
			{description}
			{openGraph}
			titleDefault="Zak Nesler"
			titleTemplate="%s – Zak Nesler"
			charset="utf-8"
			twitter={{ creator: '@zaknesler' }}
			extend={{
				link: [
					...favicons,
					{ rel: 'manifest', href: '/manifest.json' },
					{ rel: 'sitemap', href: '/sitemap-index.xml' },
				],
			}}
		/>

		<script async src="https://a.nesler.dev/js/pa-l6uh6Xn3fSlHtGGQBh1fb.js"></script>
		<script>
			// @ts-expect-error whatever
			// oxlint-disable-next-line no-unused-expressions
			((window.plausible = window.plausible || (() => (plausible.q = plausible.q || []).push(arguments))),
				// @ts-expect-error whatever
				(plausible.init = plausible.init || (i => (plausible.o = i || {}))));

			// @ts-expect-error whatever
			plausible.init();
		</script>
	</head>

	<body class="h-full w-full bg-olive-100 text-olive-600 selection:bg-olive-500/20 dark:bg-olive-950 dark:text-olive-400">
		<div class="mx-auto flex w-full max-w-2xl flex-col gap-6 px-6 py-12 md:py-16 lg:py-24 print:max-w-none">
			<Title />
			<slot />
		</div>
	</body>
</html>
