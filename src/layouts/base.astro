---
import { SEO, type SEOProps } from 'astro-seo';
import '@fontsource-variable/inter';

import { favicons } from '../constants/favicons';

import '../index.css';

type Props = {
	title?: string;
	description?: string;
	openGraph?: SEOProps['openGraph'];
};

const { title, description, openGraph } = Astro.props as Props;
---

<html lang="en">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />

		<SEO
			{title}
			{description}
			{openGraph}
			titleDefault="Zak Nesler"
			titleTemplate="%s — Zak Nesler"
			charset="utf-8"
			twitter={{ creator: '@zaknesler' }}
			extend={{
				link: [
					...favicons,
					{ rel: 'manifest', href: '/manifest.json' },
					{ rel: 'sitemap', href: '/sitemap-index.xml' },
				],
			}}
		/>

		<script async src="https://a.zak.fm/js/pa-l6uh6Xn3fSlHtGGQBh1fb.js"></script>
		<script async src="/plausible.js"></script>
	</head>

	<body class="bg-white text-olive-700 selection:bg-olive-500/20 dark:bg-olive-950 dark:text-olive-300">
		<div class="h-4 w-full bg-linear-to-r from-olive-700 to-olive-500 dark:from-olive-800 dark:to-olive-700" />

		<div class="p-8 lg:p-16">
			<div class="mx-auto flex w-full max-w-2xl flex-col gap-8 print:max-w-none">
				<slot />
			</div>
		</div>
	</body>
</html>
